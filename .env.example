# App
APP_ENV=development
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/attention_monitor

# Redis
REDIS_URL=redis://localhost:6380/0

# CV Thresholds
YAW_THRESHOLD=30
PITCH_THRESHOLD=25
NO_FACE_SECONDS=5
DISTRACTION_SECONDS=30
ATTENTION_WINDOW_SECONDS=60
EMA_ALPHA=0.3

# Alert Thresholds
ALERT_THRESHOLD=40
WARN_THRESHOLD=60

# Socket.io
SOCKETIO_CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
